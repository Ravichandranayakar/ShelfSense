# Copy to .env and fill in. Never commit .env.

# Direct StepFun (default)
STEPFUN_API_KEY=your_stepfun_or_openrouter_api_key_here
STEPFUN_BASE_URL=https://api.stepfun.ai/v1
STEPFUN_MODEL=step-3.7-flash

# OpenRouter alternative (uncomment and replace values above if using OpenRouter)
# STEPFUN_BASE_URL=https://openrouter.ai/api/v1
# STEPFUN_MODEL=stepfun/step-3.7-flash

# Optional
LOW_STOCK_THRESHOLD=10
AI_TIMEOUT_SECONDS=25
# DATABASE_PATH=./backend/store.db
