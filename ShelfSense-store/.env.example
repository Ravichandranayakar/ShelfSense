# ==============================================================================
# ShelfSense Production Environment Variables (.env.example)
# Copy this file to .env and configure real credentials. Never commit real keys.
# ==============================================================================

# 1. AI Intent Engine (Google Gemini Flash-Lite is Default Primary)
GOOGLE_API_KEY=your_gemini_api_key_here
# Optional Gemini overrides:
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GEMINI_MODEL=gemini-flash-lite-latest

# StepFun alternative (if using StepFun instead of Gemini):
# STEPFUN_API_KEY=your_stepfun_key_here
# STEPFUN_BASE_URL=https://api.stepfun.ai/v1
# STEPFUN_MODEL=step-3.7-flash

# OpenRouter alternative:
# OPENROUTER_API_KEY=your_openrouter_key_here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=google/gemini-2.0-flash-lite-001

# 2. Database Configuration
# In Render: Managed PostgreSQL connection string (e.g. postgres://user:pass@host/dbname)
# In Local Dev: Automatic fallback to local PostgreSQL or SQLite WAL mode if unset
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/shelfsense
DATABASE_PATH=./store.db

# 3. Server Runtime
LOW_STOCK_THRESHOLD=10
AI_TIMEOUT_SECONDS=25
# Render dynamically passes PORT (e.g. 10000). Leave unset locally to use 8000.
# PORT=8000

# 4. Frontend Configuration (Render Static Site or Docker Build)
# Set this in your Frontend environment on Render to your deployed backend URL:
# e.g. VITE_API_URL=https://shelfsense-backend.onrender.com
VITE_API_URL=

# 5. Gnani.ai Voice Commerce Integration (Prisma v3.0 STT & Timbre v3.0 TTS)
# Authenticates using X-API-Key-ID against https://api.vachana.ai
GNANI_API_KEY=your_gnani_api_key_here
GNANI_BASE_URL=https://api.vachana.ai
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_LANGUAGE=indic-auto
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE_KN=Shruthi
GNANI_TTS_VOICE_HI=Shivani
GNANI_TTS_VOICE_EN=Priyasharm
GNANI_TTS_VOICE_TA=Lakshmi
GNANI_TTS_VOICE_TE=Swathi
